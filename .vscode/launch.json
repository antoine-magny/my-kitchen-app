{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lancer l'app (npm run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Ouvrir http://localhost:3000",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev"
    }
  ]
}
